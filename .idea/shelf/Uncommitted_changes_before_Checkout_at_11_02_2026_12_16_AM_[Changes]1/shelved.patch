+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <link rel="stylesheet" href="../static/Login_style.css">
+    <title>Document</title>
+</head>
+<body>
+    <header>
+
+        <img src="../pics/logo.png" class="logo" alt="TU Logo">
+        <h4 div class = "uni">TEAMBA UNIVERSITY</h4>  
+
+    </header>
+      <!--this is the second header we're y'all see the bottons of home andd arrows-->
+    <div class = "second_header">
+        <div class="nav-arrows">
+            <a href="button.html" class="back-icon">
+                <img src="../pics/keyboard_arrow_left_24dp_1F1F1F.svg">
+            </a>
+        </div>
+        <ul class="nav-menu">
+            <li class="dropdown-container">
+                <a href="#" class="trigger">...</a>
+                <ul class="dropdown-menu">
+                    <li><a href="Login_page.html" class="logout-link">Log in</a></li>
+                    <li><a href="About_page.html">About</a></li>
+                </ul>
+            </li>
+        </ul>
+    </div>
+    <!-- MAIN LOGIN FORM SECTION ↓↓↓ THIS IS THE LOGIN FEATURE ↓↓↓ -->
+    <div class="login-container">
+        <div class="login-box">
+            <h2>Login</h2>
+            
+            <!-- ERROR MESSAGE -->
+            <div id="errorMessage" class="error-message" style="display:none;">
+                <p>Invalid username. Please try again.</p>
+            </div>
+            
+            <!-- THIS IS THE LOGIN FORM - Send POST request to your backend -->
+            <form id="loginForm" method="POST" action="/login/">
+                
+                <!-- USERNAME/EMAIL INPUT -->
+                <div class="form-group">
+                    <label for="username">Username or Email:</label>
+                    <input 
+                        type="text" 
+                        id="username" 
+                        name="username" 
+                        placeholder="Enter your username or email"
+                        value="CedsParty67"
+                        required
+                    >
+                </div>
+                
+                <!-- PASSWORD INPUT -->
+                <div class="form-group">
+                    <label for="password">Password:</label>
+                    <input 
+                        type="password" 
+                        id="password" 
+                        name="password" 
+                        placeholder="Enter your password"
+                        value="Welcome2CiddysParty"
+                        required
+                    >
+                </div>
+                
+                <!-- REMEMBER ME CHECKBOX (OPTIONAL) -->
+                <div class="form-group checkbox">
+                    <input type="checkbox" id="remember" name="remember">
+                    <label for="remember">Remember me</label>
+                </div>
+                
+                <!-- LOGIN BUTTON -->
+                <button type="submit" class="login-btn">Login</button>
+            </form>
+            <!-- END OF LOGIN FORM ↑↑↑ -->
+            
+            <!-- ADDITIONAL LINKS -->
+            <div class="login-footer">
+                <a href="#forgot-password">Forgot Password?</a>
+                <span>|</span>
+                <a href="#signup">Sign Up</a>
+            </div>
+        </div>
+        
+        <!-- OPTIONAL: LOGIN IMAGE SIDE -->
+        <div class="login-image">
+            <img src="../pics/Login_pic.jpg" alt="University Campus">
+        </div>
+    </div>
+    <!-- END OF LOGIN FORM SECTION ↑↑↑ -->
+
+    <script>
+        // Credentials validation
+        const correctUsername = "CedsParty67";
+        const correctPassword = "Welcome2CiddysParty";
+        
+        const usernameInput = document.getElementById('username');
+        const passwordInput = document.getElementById('password');
+        const loginForm = document.getElementById('loginForm');
+        const errorMessage = document.getElementById('errorMessage');
+        
+        // Real-time username validation
+        usernameInput.addEventListener('input', function() {
+            if (this.value !== correctUsername && this.value.length > 0) {
+                errorMessage.textContent = 'Invalid username. Please try again.';
+                errorMessage.style.display = 'block';
+            } else {
+                errorMessage.style.display = 'none';
+            }
+        });
+        
+        // Form submission validation
+        loginForm.addEventListener('submit', function(event) {
+            event.preventDefault(); // Prevent default form submission
+            
+            const username = usernameInput.value;
+            const password = passwordInput.value;
+            
+            // Check if credentials are correct
+            if (username === correctUsername && password === correctPassword) {
+                // Credentials are correct - you can proceed with login
+                alert('Login successful!');
+                // You can redirect or submit the form here
+                window.location.href = 'button.html';
+            } else if (username !== correctUsername) {
+                errorMessage.textContent = 'Invalid username. Please try again.';
+                errorMessage.style.display = 'block';
+            } else if (password !== correctPassword) {
+                errorMessage.textContent = 'Invalid password. Please try again.';
+                errorMessage.style.display = 'block';
+            } else {
+                errorMessage.textContent = 'Invalid username or password.';
+                errorMessage.style.display = 'block';
+            }
+        });
+    </script>
+</body> 
+</html>
